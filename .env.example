# --- Server-side cache (Upstash Redis) ---
# Create a free database at https://console.upstash.com/ then copy the
# REST URL + token from the "REST API" tab. Without these, the app still
# works but falls through to CoinGecko on every request (rate limits will bite).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional: CoinGecko Pro key ---
# Free public API works without a key; this is only for higher rate limits.
COINGECKO_API_KEY=

# --- Cron secret (Phase 3) ---
# Random string. Vercel Cron passes this as Bearer to /api/cron/warm.
CRON_SECRET=
